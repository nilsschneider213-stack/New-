// Einstellungen für Cloudflare (Workers mit statischen Dateien).
// Die Website besteht aus fertigen Dateien – es wird nichts gebaut.
{
  "name": "new",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    // Adressen mit .html beibehalten (passend zu Sitemap und Google-Angaben)
    "html_handling": "none"
  }
}
